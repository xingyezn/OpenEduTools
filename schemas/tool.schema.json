{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenEduTools tool metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "name", "description", "category", "subjects", "tags", "version", "status",
    "entry", "icon", "offline", "dataPolicy", "featured", "createdAt", "updatedAt"
  ],
  "properties": {
    "$schema": { "const": "../../schemas/tool.schema.json" },
    "id": { "type": "string", "minLength": 2, "maxLength": 50, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 2, "maxLength": 20 },
    "description": { "type": "string", "minLength": 8, "maxLength": 100 },
    "category": {
      "enum": ["lesson-planning", "classroom-management", "assessment", "research", "data-processing", "text-processing", "ai-assistance", "general"]
    },
    "subjects": {
      "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": { "enum": ["general", "language", "mathematics", "science", "humanities", "arts", "physical-education", "information-technology"] }
    },
    "tags": {
      "type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 20, "pattern": "^[^#]+$" }
    },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "status": { "enum": ["experimental", "beta", "stable", "deprecated"] },
    "entry": { "type": "string", "pattern": "^tools/[a-z0-9]+(?:-[a-z0-9]+)*/index\\.html$" },
    "icon": { "type": "string", "enum": ["user-search", "users", "timer", "text-clean", "chart", "handwriting", "volume", "clock"] },
    "offline": { "const": true },
    "dataPolicy": { "const": "local-only" },
    "featured": { "type": "boolean" },
    "createdAt": { "type": "string", "format": "date" },
    "updatedAt": { "type": "string", "format": "date" }
  }
}
